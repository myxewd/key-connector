# Copy to .env and edit, then protect it: chmod 600 .env
# docker compose reads this file automatically.

# --- Database (your existing MySQL) ------------------------------------------
# Full sqlx URL. The database must already exist; the connector creates its
# table on first start unless you pre-create it (see README).
# Percent-encode reserved characters in the password (@ : / ? # %).
# For a remote or managed server add TLS, e.g. ?ssl-mode=REQUIRED
KC_DATABASE_URL=mysql://keyconnector:change-me@mysql.example.com:3306/keyconnector?ssl-mode=REQUIRED

# --- Identity provider -------------------------------------------------------
# OIDC discovery base URL, e.g. https://vault.example.com/identity
KC_IDENTITY_AUTHORITY=https://vault.example.com/identity
# When using a static key instead, also set the issuer:
# KC_JWT_ISSUER=https://vault.example.com|login

# --- Connector behaviour -----------------------------------------------------
# Browser origin that may call the connector (your web vault origin).
KC_CORS_ALLOWED_ORIGINS=https://vault.example.com
# Mount the API under a subpath, e.g. /kc. Empty serves it at the root.
KC_API_PREFIX=/kc
RUST_LOG=key_connector=info,tower_http=warn
